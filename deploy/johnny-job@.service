# One of Johnny's report jobs: news, watch, brief-close, brief-night.
# Run by the johnny-*.timer units; see mavis/jobs.py.
[Unit]
Description=Johnny job %i
After=network-online.target
Wants=network-online.target
# A failed job pages the owner (once per failure, says only which job).
OnFailure=mavis-alert@%n.service

[Service]
Type=oneshot
User=mavis
Group=mavis
WorkingDirectory=/opt/mavis/mavis
# Groq key (briefs) and the ntfy topic (pushes).
EnvironmentFile=/var/lib/mavis/env
Environment=HOME=/var/lib/mavis
ExecStart=/opt/mavis/mavis/.venv/bin/python /opt/mavis/mavis/jobs.py %i
StateDirectory=mavis
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=300
# No localhost: the API trusts Tailscale logins from 127.0.0.1, so nothing
# but tailscale serve may connect there.
IPAddressDeny=localhost
# ...except Ubuntu's DNS stub, 127.0.0.53 (the API listens on 127.0.0.1 only).
IPAddressAllow=127.0.0.53/32
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
